# Get this from https://www.recall.ai → Developers → API keys
RECALL_API_KEY=your_recall_api_key_here

# Must match the region of the workspace that issued the key.
# Common values: us-east-1, us-west-2, eu-central-1, ap-northeast-1
RECALL_REGION=us-west-2

# OpenAI key for extracting FAQs from the meeting transcript
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional — defaults to gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# Server bind (Docker / cloud should use 0.0.0.0)
HOST=0.0.0.0
PORT=8765

# Stable id for this machine's calendar user in Recall Calendar V1
CALENDAR_USER_ID=local-user

# Google Calendar OAuth (Web client). Also paste Client ID + Secret into the Recall dashboard.
# Redirect URI: https://$RECALL_REGION.recall.ai/api/v1/calendar/google_oauth_callback/
GOOGLE_OAUTH_CLIENT_ID=

# Microsoft Outlook OAuth (Azure app). Also paste credentials into the Recall dashboard.
# Redirect URI: https://$RECALL_REGION.recall.ai/api/v1/calendar/ms_oauth_callback/
MICROSOFT_OAUTH_CLIENT_ID=
